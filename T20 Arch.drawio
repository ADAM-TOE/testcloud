        <mxCell id="1eDpuPcIiptN3DuVN0TX-38" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Web Subnet Flow&lt;/h1&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;Two-way → IntelligenceSubnet:&lt;/strong&gt; Send queries, receive AI responses&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;One-way → SearchSubnet:&lt;/strong&gt; Send search queries via API Management&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;One-way → MonitorSubnet:&lt;/strong&gt; Send telemetry and logs&lt;/li&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;fillColor=#d5e8d4;strokeColor=#82b366;gradientColor=#97d077;" parent="1" vertex="1">
