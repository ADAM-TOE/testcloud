        <mxCell id="1eDpuPcIiptN3DuVN0TX-50" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Data Subnet Flow&lt;/h1&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;One-way → IntelligenceSubnet:&lt;/strong&gt; Supplies structured data for reasoning&lt;/li&gt;&lt;br&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;One-way → SearchSubnet:&lt;/strong&gt; Supplies data for indexing and semantic search&lt;/li&gt;&lt;br&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;One-way → MonitorSubnet:&lt;/strong&gt; Sends telemetry and logs&lt;/li&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" parent="1" vertex="1">
