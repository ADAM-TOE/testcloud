        </mxCell>
        <mxCell id="1eDpuPcIiptN3DuVN0TX-49" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Search Subnet Flow&lt;/h1&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;Two-way ↔ IntelligenceSubnet:&lt;/strong&gt; Accepts vector queries and returns search results&lt;/li&gt;&lt;br&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;One-way ← WebSubnet:&lt;/strong&gt; Receives search requests via API Management&lt;/li&gt;&lt;br&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;One-way → DataSubnet:&lt;/strong&gt; Pulls data for indexing&lt;/li&gt;&lt;br&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;One-way → MonitorSubnet:&lt;/strong&gt; Sends telemetry and logs&lt;/li&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" parent="1" vertex="1">
