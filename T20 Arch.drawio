        </mxCell>
        <mxCell id="1eDpuPcIiptN3DuVN0TX-39" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Intelligence Subnet Flow&lt;/h1&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;Two-way → WebSubnet:&lt;/strong&gt; Receives user queries and returns AI-driven responses&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;Two-way → SearchSubnet:&lt;/strong&gt; Sends vector queries and receives semantic search results&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;One-way → DataSubnet:&lt;/strong&gt; Reads structured data for reasoning and context&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;___ccc16d0 fje8fi8 f1ng9h0j f1bwykku f18jd3zf&quot;&gt;&lt;strong&gt;One-way → MonitorSubnet:&lt;/strong&gt; Logs agent activity and performance metrics&lt;/li&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fillColor=#fff2cc;gradientColor=#ffd966;strokeColor=#d6b656;" parent="1" vertex="1">
